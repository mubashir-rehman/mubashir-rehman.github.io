---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/Crumbs.astro";
import { graph, breadcrumb, webPage, personRef, SITE } from "@/lib/schema";

const posts = (await getCollection("journal", (p) => p.data.status === "published")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const types: Record<string, string> = { incident: "Incident", "lab-note": "Lab note", "build-log": "Build log", essay: "Essay" };
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const title = "Writing: Backend Systems and Applied AI";
const description = "Build logs and incident write-ups on backend systems and applied AI by Mubashir Rehman. What broke, what changed, and the answer first.";
const canonical = `${SITE}/journal/`;
const schema = graph([
  webPage("CollectionPage", canonical, title, description, {
    mainEntity: { "@type": "Blog", name: "Writing", author: personRef, blogPost: posts.map((p) => ({ "@type": "BlogPosting", headline: p.data.title, url: `${SITE}/journal/${p.id}/`, datePublished: p.data.date.toISOString().slice(0, 10) })) },
  }),
  breadcrumb(canonical, [{ name: "Writing", path: "/journal/" }]),
]);
---
<Base title={title} description={description} path="/journal/" schema={schema}>
  <div class="wrap page-head">
    <Crumbs items={[{ name: "Writing" }]} />
    <h1 class="h1">Writing</h1>
    <p class="lead">Build logs and incident write-ups. The answer comes first.</p>
    <p class="meta" style="margin-top:var(--s-4)">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
  </div>
  <section class="wrap" aria-label="All posts">
    <ul class="works works--wide">
      {posts.map((p) => (
        <li class="work">
          <div>
            <h2 class="work__title"><a href={`/journal/${p.id}/`}>{p.data.title}</a></h2>
            <p class="work__sum">{p.data.lede}</p>
          </div>
          <p class="work__side meta">{types[p.data.type]}<br /><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></p>
        </li>
      ))}
    </ul>
    <p class="small" style="margin-top:var(--s-5)">Follow along with the <a class="link" href="/rss.xml">RSS feed</a>.</p>
  </section>
</Base>
