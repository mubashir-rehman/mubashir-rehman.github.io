---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/Crumbs.astro";
import { numWord, cap } from "@/lib/text";
import { graph, breadcrumb, webPage, personRef, SITE } from "@/lib/schema";

const posts = (await getCollection("journal", (p) => p.data.status === "published")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const types: Record<string, string> = { incident: "Incident", "lab-note": "Lab note", "build-log": "Build log", essay: "Essay" };
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const title = "Writing: Backend Systems and Applied AI";
const description = "Build logs and incident write-ups on backend systems and applied AI by Mubashir Rehman. What broke, what changed, and the answer first.";
const canonical = `${SITE}/journal/`;
const schema = graph([
  webPage("CollectionPage", canonical, title, description, {
    mainEntity: { "@type": "Blog", name: "Writing", author: personRef, blogPost: posts.map((p) => ({ "@type": "BlogPosting", headline: p.data.title, url: `${SITE}/journal/${p.id}/`, datePublished: p.data.date.toISOString().slice(0, 10) })) },
  }),
  breadcrumb(canonical, [{ name: "Writing", path: "/journal/" }]),
]);
---
<Base title={title} description={description} path="/journal/" schema={schema}>
  <div class="j wrap">
    <Crumbs items={[{ name: "Writing" }]} />
    <div class="j-grid">
      <header class="j-card cs-hero wk-hero">
        <p class="j-eyebrow"><b>Writing</b> · {cap(numWord(posts.length))} {posts.length === 1 ? "post" : "posts"}</p>
        <h1>Writing</h1>
        <p class="j-lead">Build logs and incident write-ups. The answer comes first.</p>
      </header>
      <aside class="j-card wk-how" aria-labelledby="kinds-h">
        <h2 class="j-eyebrow" id="kinds-h">Kinds of post</h2>
        <ol>{Object.values(types).map((t, i) => <li><span>{String(i + 1).padStart(2, "0")}</span>{t}</li>)}</ol>
        <p class="wk-links jr-rss"><a href="/rss.xml">RSS feed</a></p>
      </aside>
    </div>
    <section class="j-part jr-list-sec" aria-label="All posts">
      <ul class="j-grid jr-list">
        {posts.map((p) => (
          <li class="j-card jr-post">
            <p class="j-eyebrow"><b>{types[p.data.type]}</b> · <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></p>
            <h2><a href={`/journal/${p.id}/`}>{p.data.title}</a></h2>
            <p class="j-a">{p.data.lede}</p>
            <p class="j-proof"><a href={`/journal/${p.id}/`}>Read the post →</a></p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
