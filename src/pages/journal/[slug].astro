---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageTop from "@/components/PageTop.astro";
import Crumbs from "@/components/Crumbs.astro";
import Icon from "@/components/Icon.astro";
import profile from "@/data/profile.json";
import { graph, breadcrumb, faqPage, personRef, SITE } from "@/lib/schema";

// Only published posts get a page. Drafts and archived posts are never built; an archived post
// that was once public keeps its URL through a redirect (astro.config.mjs).
export async function getStaticPaths() {
  const posts = await getCollection("journal", (p) => p.data.status === "published");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<"journal"> }
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const path = `/journal/${entry.id}/`;
const canonical = `${SITE}${path}`;
const types: Record<string, string> = { incident: "Incident report", "lab-note": "Lab note", "build-log": "Build log", essay: "Essay" };
const fmt = (x: Date) => x.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const words = (entry.body ?? "").split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 230));
const title = d.seoTitle ?? d.title;
const h2s = headings.filter((h) => h.depth === 2);
const schema = graph([
  {
    "@type": "BlogPosting",
    "@id": `${canonical}#article`,
    headline: d.title,
    description: d.description,
    url: canonical,
    datePublished: d.date.toISOString().slice(0, 10),
    ...(d.updated ? { dateModified: d.updated.toISOString().slice(0, 10) } : {}),
    author: personRef,
    inLanguage: "en",
    keywords: d.tags.join(", "),
    wordCount: words,
  },
  breadcrumb(canonical, [{ name: "Writing", path: "/journal/" }, { name: d.title, path }]),
  ...(d.faq?.length ? [faqPage(canonical, d.faq)] : []),
]);
---
<Base title={title} description={d.description} path={path} schema={schema} article={{ published: d.date, modified: d.updated, section: types[d.type], tags: d.tags }}>
  <article class="j wrap jr">
    <PageTop crumbs={[{ name: "Writing", path: "/journal/" }, { name: d.title }]} title={d.title} lead={d.lede}>
      <p slot="eyebrow" class="j-eyebrow"><b>{types[d.type]}</b> · {minutes} minute read</p>
      <aside slot="side" class="j-card cs-glance pt-side" aria-label="About this post">
        <p class="j-eyebrow">About this post</p>
        <dl>
          <div><dt>Published</dt><dd><time datetime={d.date.toISOString()}>{fmt(d.date)}</time>{d.updated && <span class="cs-asof">, updated <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></span>}</dd></div>
          <div><dt>By</dt><dd><a href="/about/">{profile.name}</a></dd></div>
          {d.note && <div><dt>Note</dt><dd class="jr-note">{d.note}</dd></div>}
        </dl>
      </aside>
    </PageTop>
    <div class="jr-body">
      {h2s.length >= 3 && words > 700 && (
        <nav aria-label="On this page" class="cs-toc jr-toc">
          <ol>{h2s.map((h, i) => <li><a href={`#${h.slug}`}><span>{String(i + 1).padStart(2, "0")}</span>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="jr-main">
        <div class="prose"><Content /></div>
        {d.rule && <blockquote class="j-card cs-rule jr-rule"><p>{d.rule}</p><p class="cs-rule__n">The rule I took from this</p></blockquote>}
        {d.faq?.length ? (
          <section class="jr-faq" aria-labelledby="faq-h">
            <h2 id="faq-h">Questions</h2>
            <div class="cs-stack">{d.faq.map((f) => <div class="j-card ro-q"><h3>{f.q}</h3><p class="j-a">{f.a}</p></div>)}</div>
          </section>
        ) : null}
      </div>
    </div>
    <section class="cs-next" aria-labelledby="next-h">
      <h2 id="next-h" class="sr">Keep reading</h2>
      <div class="j-grid">
        <a class="j-card cs-nextcard" href="/journal/">
          <p class="j-eyebrow"><b>More writing</b></p>
          <p class="cs-nextcard__t">All build logs and incident write-ups</p>
          <span class="cs-go" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
        </a>
        <a class="j-card cs-nextcard cs-also" href="/projects/">
          <p class="j-eyebrow"><b>The work</b></p>
          <p class="cs-nextcard__t">The case studies behind these posts</p>
          <span class="cs-go" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
        </a>
        <div class="j-card j-contact cs-contact">
          <div>
            <p class="j-contact__k">Working on something similar?</p>
            <p class="cs-contact__t">Tell me what the system is doing, and what it should be doing.</p>
          </div>
          <div class="j-contact__end">
            <a class="btn btn--lg j-contact__btn" href={`mailto:${profile.email}?subject=${encodeURIComponent(`About: ${d.title}`)}`}><Icon name="mail" size={18} />Email me</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</Base>
