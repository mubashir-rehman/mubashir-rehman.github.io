---
/**
 * journal/[slug].astro — static blog post pages.
 * Markdown rendered to static HTML at build time via react-markdown
 * (no client directive → zero client JS).
 */
import PageLayout from "@/layouts/PageLayout.astro";
import Markdown from "@/components/Markdown";
import journal from "@/data/journal.json";
import profile from "@/data/profile.json";

export function getStaticPaths() {
  return journal.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const SITE = "https://mubashir-rehman.is-a.dev";

// `updated` is an optional per-entry field in journal.json (ISO date string).
// Absent on posts that have never been revised — in that case dateModified
// falls back to the publish date rather than claiming a revision that never
// happened.
const dateModified = entry.updated ?? entry.date;
const wasRevised = Boolean(entry.updated) && entry.updated !== entry.date;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.title,
  description: entry.excerpt,
  datePublished: entry.date,
  dateModified,
  url: `${SITE}/journal/${entry.slug}/`,
  image: `${SITE}/og-image.png`,
  inLanguage: "en",
  keywords: entry.tags?.join(", "),
  author: { "@type": "Person", name: "Mubashir Rehman", url: SITE },
  publisher: { "@type": "Person", name: "Mubashir Rehman", url: SITE },
  isPartOf: { "@type": "Blog", name: "Mubashir Rehman — Blog", url: `${SITE}/journal/` },
};

// Breadcrumb trail: Home → Blog → this post. "Blog" matches the navbar label
// for /journal/ and the "All posts" link at the top of the article.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${SITE}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: `${SITE}/journal/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: entry.title,
      item: `${SITE}/journal/${entry.slug}/`,
    },
  ],
};

// Optional per-entry `faq: [{ q, a }]` — same field names as roles.json, so
// this mirrors the FAQPage builder in for/[role].astro. Posts without an FAQ
// emit no FAQPage node at all rather than an empty one.
const faqs = entry.faq ?? [];
const faqSchema = faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    }
  : null;

const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<PageLayout
  title={entry.title}
  description={entry.seoDescription ?? entry.excerpt}
  canonicalPath={`/journal/${entry.slug}/`}
  schema={schemas}
>
  <!-- 42rem + 1.5rem gutters ≈ 600px of text ≈ 66ch at 16px Inter — inside the
       60–75ch measure design-system/MASTER.md mandates. The padding is pinned
       (not sm:-scaled) because it sets the measure as much as max-width does. -->
  <article class="mx-auto max-w-[42rem] px-6 py-16 md:py-20">
    <a
      href="/journal/"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      All posts
    </a>

    <header class="mt-8">
      <p class="font-mono text-xs text-muted-foreground">
        <time datetime={entry.date}>{entry.date}</time>
        {wasRevised && <> · updated {entry.updated}</>}
      </p>
      <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
        {entry.title}
      </h1>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {
          entry.tags?.map((t) => (
            <span class="chip">
              {t}
            </span>
          ))
        }
      </div>

      {/* Byline with a real photo — an author identity a reader (and an answer
          engine assessing E-E-A-T) can attach the writing to. */}
      <div class="mt-6 flex items-center gap-3">
        <img
          src={profile.image}
          srcset={`/mubashir-rehman-176.webp 1x, ${profile.image} 2x`}
          alt=""
          width="44"
          height="44"
          loading="lazy"
          decoding="async"
          class="h-11 w-11 flex-none rounded-full border border-border object-cover"
        />
        <div class="min-w-0">
          <a href="/about/" class="text-sm font-semibold transition-colors hover:text-primary">
            {profile.name}
          </a>
          <p class="mt-0.5 text-xs text-muted-foreground">
            {profile.currentRole.role} at {profile.currentRole.company} · co-author,
            peer-reviewed ECG/ML research
          </p>
        </div>
      </div>
    </header>

    <!-- Plain `prose` (16px), not `prose-sm` — prose-sm is 14px and put mobile
         body text under the 16px floor in MASTER.md. The article constrains the
         width, so prose's own measure is released with max-w-none. -->
    <div class="prose mt-10 max-w-none">
      <Markdown content={entry.content} />
    </div>

    {
      faqs.length > 0 && (
        <section class="mt-16 border-t border-border pt-10" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="text-2xl font-semibold tracking-tight">
            Frequently asked questions
          </h2>
          {/* A <dl> rather than the bordered cards role pages use: this is a
              long-form article, and keeping it card-free preserves the reading
              column. Role pages stay as cards — different surface, different job. */}
          <dl class="mt-6 space-y-8">
            {faqs.map((faq) => (
              <div>
                <dt class="text-lg font-semibold tracking-tight">{faq.q}</dt>
                <dd class="mt-2 leading-relaxed text-muted-foreground">{faq.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </article>
</PageLayout>
