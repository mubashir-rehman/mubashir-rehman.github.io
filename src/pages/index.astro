---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Trace from "@/components/Trace.astro";
import Artifact from "@/components/Artifact.astro";
import Incident from "@/components/Incident.astro";
import { Image } from "astro:assets";
import headshot from "@/assets/mubashir-rehman.webp";
import profile from "@/data/profile.json";
import roles from "@/data/roles.json";
import problems from "@/data/problems.json";
import { numWord } from "@/lib/text";
import { graph, website, personFull, webPage, SITE } from "@/lib/schema";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const byId = (id: string) => work.find((w) => w.id === id)!;
const flagships = work.filter((w) => w.data.flagship);
const moreCount = work.length - flagships.length;
const HOME_RULES = [1, 2, 3, 8];
// The decision that best shows systems judgement within about 45 words (index into decisions[]).
const SPOTLIGHT: Record<string, number> = { "dental-ai-front-desk": 1, "social-signal-intelligence-backend": 1, "erp-ai-agents": 2 };
const rules = work.filter((w) => w.data.rule).map((w) => ({ ...w.data.rule!, slug: w.id, title: w.data.title })).sort((a, b) => a.n - b.n);
const homeRules = HOME_RULES.map((n) => rules.find((r) => r.n === n)).filter(Boolean) as typeof rules;
// One incident each from dental, social-signal and the healthcare console (the first listed).
const incidents = ["dental-ai-front-desk", "social-signal-intelligence-backend", "healthcare-integration-console"].map((id) => ({ w: byId(id), b: byId(id).data.broke[0] }));
const posts = (await getCollection("journal", (p) => p.data.status === "published")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const resume = profile.resumes[profile.defaultResume as keyof typeof profile.resumes];
const utc = profile.location.timezone.match(/UTC[+-]\d+/)?.[0] ?? profile.location.timezone;
const openTo = profile.availabilityShort.replace(/^Open to /, "");
const openRoles = roles.filter((r) => r.slug === "backend" || r.slug === "ai-backend");
const ym = (s: string) => (s === "present" ? "now" : new Date(`${s}-01`).toLocaleDateString("en-GB", { month: "short", year: "numeric" }));
const nn = (i: number) => String(i + 1).padStart(2, "0");

const schema = graph([website, personFull(), webPage("WebPage", `${SITE}/`, profile.seo.homeTitle, profile.seo.homeDescription, { about: { "@id": `${SITE}/#person` } })]);
---
<Base title={profile.seo.homeTitle} description={profile.seo.homeDescription} path="/" schema={schema}>
  <section class="hero wrap" aria-labelledby="hero-h">
    <div class="hero__grid">
      <div class="hero__main">
        <div class="who">
          <Image src={headshot} alt={profile.name} width={48} height={48} loading="eager" class="who__img" />
          <p class="who__txt"><strong>{profile.name}</strong><span>{profile.label}</span></p>
        </div>
        <h1 class="statement statement--home" id="hero-h">
          <span class="s1">{profile.heroLine[0]}</span> <span class="s2">{profile.heroLine[1]}</span> <span class="s3">{profile.heroLine[2]}</span>
        </h1>
        <p class="hero__id">{profile.servicesLead}</p>
        <p class="meta">{profile.current.title}, {profile.current.employer} · {profile.location.city} · {utc}<span class="meta__more"><br />{profile.yearsFullTime} years in production · {profile.availabilityShort}</span></p>
        <div class="actions">
          <a class="btn btn--primary btn--lg" href={resume.file}><svg class="i" aria-hidden="true"><use href="#i-download" /></svg>Download résumé (PDF)</a>
          <a class="btn btn--secondary btn--lg" href={`mailto:${profile.email}`}><svg class="i" aria-hidden="true"><use href="#i-mail" /></svg>Email me</a>
          <a class="link" href="#work">See the work ↓</a>
        </div>
        <p class="router"><a href={`/for/${roles[0].slug}/`}>Hiring for a specific role? →</a></p>
      </div>
    </div>
    <Trace />
  </section>

  <section class="sec wrap" aria-labelledby="rules-h">
    <div class="sec__grid">
      <div class="sec__head"><h2 class="label" id="rules-h">01 / How I work</h2></div>
      <div class="sec__body sec__body--read">
        <ol class="rules">
          {homeRules.map((r) => (
            <li class="rule">
              <span class="rule__n" aria-hidden="true">{r.n}</span>
              <div><p class="rule__t"><span class="sr">Rule {r.n}: </span>{r.text}</p><p class="rule__w meta">from: <a class="link" href={`/projects/${r.slug}/`}>{r.title}</a></p></div>
            </li>
          ))}
        </ol>
        <p class="small"><a class="link" href="/about/#rules">All {numWord(rules.length)} rules →</a></p>
      </div>
    </div>
  </section>

  <section class="sec wrap" id="work" aria-labelledby="work-h">
    <div class="sec__grid">
      <div class="sec__head"><h2 class="label" id="work-h">02 / Selected work</h2></div>
      <div class="sec__body">
        {flagships.map((w, i) => <Artifact entry={w} n={i + 1} flip={i % 2 === 1} spotlight={SPOTLIGHT[w.id] ?? 0} />)}
        <p class="small"><a class="link" href="/projects/">+ {moreCount} more case studies, open source and research →</a></p>
      </div>
    </div>
  </section>

  <section class="sec wrap" aria-labelledby="break-h">
    <div class="sec__grid">
      <div class="sec__head"><h2 class="label" id="break-h">03 / When things break</h2></div>
      <div class="sec__body sec__body--read">
        {incidents.map(({ w, b }) => <Incident title={b.title} symptom={b.symptom} cause={b.cause} fix={b.fix} href={`/projects/${w.id}/`} from={w.data.title} />)}
      </div>
    </div>
  </section>

  <section class="sec wrap" aria-labelledby="called-h">
    <div class="sec__grid">
      <div class="sec__head"><h2 class="label" id="called-h">04 / Where I usually get called</h2></div>
      <div class="sec__body sec__body--read">
        <ol class="works works--compact">
          {problems.map((p, i) => (
            <li class="work"><p class="work__title"><span class="meta">{nn(i)} </span><a href={`/projects/${p.slug}/`}>{p.h}</a></p></li>
          ))}
        </ol>
        <p class="small"><a class="link" href="/services/">Problems I solve →</a></p>
      </div>
    </div>
  </section>

  <section class="sec wrap" aria-labelledby="now-h">
    <div class="sec__grid">
      <div class="sec__head"><h2 class="label" id="now-h">05 / Currently</h2></div>
      <div class="sec__body sec__body--read">
        <ul class="cur">
          <li><span class="meta">Now</span><span>{profile.current.title} at {profile.current.employer}, leading {numWord(profile.current.teamSize)} engineers</span></li>
          {posts.length > 0 && <li><span class="meta">Writing</span><span>{posts.map((p, i) => <><a class="link" href={`/journal/${p.id}/`}>{p.data.title}</a>{i < posts.length - 1 ? " · " : ""}</>)}</span></li>}
          <li><span class="meta">Research</span><span><a class="link" href={profile.paper.url}>{profile.paper.journal}, {profile.paper.publisher}, {profile.paper.year}</a></span></li>
          <li><span class="meta">Open to</span><span>{openTo}: {openRoles.map((r, i) => <><a class="link" href={`/for/${r.slug}/`}>{r.label}</a>{i < openRoles.length - 1 ? ", " : ""}</>)}</span></li>
        </ul>
        <p class="small"><a class="link" href="/about/">Full background →</a></p>
      </div>
    </div>
  </section>

  <section class="sec close wrap" aria-labelledby="close-h">
    <h2 class="h2" id="close-h">Tell me what the system is doing. Tell me what it should be doing.</h2>
    <p class="actions"><a class="btn btn--primary btn--lg" href={`mailto:${profile.email}`}>{profile.email} →</a></p>
    <p class="meta">{profile.location.city}, {profile.location.country} · {profile.availabilityShort}</p>
    <p class="small"><a class="link" href={resume.file}>Download résumé</a></p>
  </section>
</Base>
