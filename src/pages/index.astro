---
// The home page as a journey (docs/redesign/v3/PLAN.md): who and what, what I deliver, how I fix what is
// broken, how I get from an unclear ask to something shipped, the path so far, the work, the toolbox, contact.
// Every fact comes from src/data or the work collection; nothing is typed in here.
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Trace from "@/components/Trace.astro";
import Icon from "@/components/Icon.astro";
import Spine from "@/components/Spine.astro";
import MiniDiagram from "@/components/MiniDiagram.astro";
import { Image } from "astro:assets";
import Portrait from "@/components/Portrait.astro";
import shotHireDark from "@/assets/work/hiretrack-dark.jpg";
import shotHireLight from "@/assets/work/hiretrack-light.jpg";
import shotQuetta from "@/assets/work/quettatea.jpg";
import profile from "@/data/profile.json";
import problems from "@/data/problems.json";
import approach from "@/data/approach.json";
import toolbox from "@/data/toolbox.json";
import builds from "@/data/builds.json";
import { numWord } from "@/lib/text";
import { graph, website, personFull, webPage, SITE } from "@/lib/schema";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const byId = (id: string) => work.find((w) => w.id === id)!;
const resume = profile.resumes[profile.defaultResume as keyof typeof profile.resumes];
const utc = profile.location.timezone.match(/UTC[+-]\d+/)?.[0] ?? profile.location.timezone;
const team = numWord(profile.current.teamSize);

// 02: the four steps, each illustrated by the dental case study's first incident and its rule.
const dental = byId(approach.broken.case);
const incident = dental.data.broke[0];
const example: Record<string, string> = {
  symptom: incident.symptom,
  cause: incident.cause,
  fix: incident.fix,
  rule: `Rule ${dental.data.rule!.n}: ${dental.data.rule!.text}`,
};

// 05: the work.
const signal = byId("social-signal-intelligence-backend");
const hiretrack = byId("hiretrack");
const quetta = builds.find((b) => b.title.startsWith("The Quetta Tea 2.0"))!;

const sections = [
  { id: "deliver", h: "What I deliver", p: "Pick the problem that sounds like yours." },
  { id: "broken", h: "When something is broken", p: "The same four steps, every time. One real case." },
  { id: "zero", h: "When nothing exists yet", p: `From an unclear ask to something shipped. ${numWord(approach.zero.cases.length).replace(/^./, (c) => c.toUpperCase())} real cases.` },
  { id: "path", h: "The path so far", p: "Each step added something I still use." },
  { id: "work", h: "The work behind it", p: "Systems I have had to understand." },
  { id: "toolbox", h: "Toolbox", p: "What I have used to ship, grouped by where it sits in a system." },
];
const S = Object.fromEntries(sections.map((s, i) => [s.id, { ...s, n: String(i + 1).padStart(2, "0") }]));

const schema = graph([website, personFull(), webPage("WebPage", `${SITE}/`, profile.seo.homeTitle, profile.seo.homeDescription, { about: { "@id": `${SITE}/#person` } })]);
---
<Base title={profile.seo.homeTitle} description={profile.seo.homeDescription} path="/" schema={schema}>
  <div class="j wrap">
    <section class="j-grid j-top" aria-labelledby="hero-h">
      <div class="j-card j-hero">
        <p class="j-eyebrow"><b>{profile.label}</b> · {profile.location.city}, {profile.availabilityShort.toLowerCase()}</p>
        <div>
          <h1 id="hero-h"><span class="l1">{profile.heroLine[0]}</span> <span class="l2">{profile.heroLine[1]}</span> <span class="l3">{profile.heroLine[2]}</span></h1>
          <p class="j-lead">{profile.servicesLead}</p>
        </div>
        <div class="j-cta">
          <a class="btn btn--primary btn--lg" href="#deliver">See what I deliver<Icon name="arrow-down" size={18} /></a>
          <a class="btn btn--secondary btn--lg" href={resume.file}><Icon name="download" size={18} />Download résumé</a>
        </div>
      </div>
      <Portrait right={`${profile.location.city} · ${utc}`} />
      <div class="j-card j-now">
        <p class="j-eyebrow">Now</p>
        <p class="j-now__t">{profile.current.title} at {profile.current.employer}, leading {team} engineers.</p>
      </div>
      <div class="j-card j-trace">
        <p class="j-eyebrow j-trace__cap">Noise in, <b>boring out.</b></p>
        <Trace />
      </div>
    </section>

    <section class="j-part" id="deliver" aria-labelledby="deliver-h">
      <div class="j-head"><span class="j-num" aria-hidden="true">{S.deliver.n}</span><div><h2 id="deliver-h">{S.deliver.h}</h2><p>{S.deliver.p}</p></div></div>
      <div class="j-grid">
        {problems.map((p, i) => (
          <article class:list={["j-card j-deliver", { "is-wide": i < 2 }]}>
            <span class="j-ico"><Icon name={p.icon as any} /></span>
            <p class="j-k">If you have</p>
            <h3>{p.h}</h3>
            <p class="j-k">You get</p>
            <p class="j-a">{p.what}</p>
            <p class="j-proof">Proof: <a href={`/projects/${p.slug}/`}>{p.link} →</a></p>
          </article>
        ))}
      </div>
    </section>

    <section class="j-part" id="broken" aria-labelledby="broken-h">
      <div class="j-head"><span class="j-num" aria-hidden="true">{S.broken.n}</span><div><h2 id="broken-h">{S.broken.h}</h2><p>{S.broken.p}</p></div></div>
      <ol class="j-steps">
        {approach.broken.steps.map((s, i) => (
          <li class="j-card j-step">
            <span class="j-dot"><Icon name={s.icon as any} size={20} /></span>
            <h3><span class="j-stepn">{i + 1}</span>{s.h}</h3>
            <p>{s.p}</p>
            <p class="j-ex">{example[s.from]}</p>
          </li>
        ))}
      </ol>
      <p class="j-more"><a href={`/projects/${dental.id}/`}>The full incident: {incident.title.toLowerCase()} →</a></p>
    </section>

    <section class="j-part" id="zero" aria-labelledby="zero-h">
      <div class="j-head"><span class="j-num" aria-hidden="true">{S.zero.n}</span><div><h2 id="zero-h">{S.zero.h}</h2><p>{S.zero.p}</p></div></div>
      <ol class="j-ztrack">
        {approach.zero.stages.map((s, i) => (
          <li class:list={["j-card j-zs", s.fuzzy ? "is-fuzzy" : "is-solid"]}>
            <span class="j-dot"><Icon name={s.icon as any} size={20} /></span>
            <h3><span class="j-stepn">{i + 1}</span>{s.h}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ol>
      <div class="j-zcases">
        {approach.zero.cases.map((c) => (
          <article class="j-card j-zc">
            <p class="j-k j-k--muted">The ask</p>
            <p class="j-ask">{c.ask}</p>
            <span class="j-arrow" aria-hidden="true"></span>
            <p class="j-k">What shipped</p>
            <h3 class="j-got">{c.got}</h3>
            <p class="j-how">{c.how}</p>
            <p class="j-proof"><a href={`/projects/${c.slug}/`}>{byId(c.slug).data.title} →</a></p>
          </article>
        ))}
      </div>
    </section>

    <section class="j-part" id="path" aria-labelledby="path-h">
      <div class="j-head"><span class="j-num" aria-hidden="true">{S.path.n}</span><div><h2 id="path-h">{S.path.h}</h2><p>{S.path.p}</p></div></div>
      <div class="j-journey">
        <Spine />
        <ol class="j-chapters">
          {approach.path.map((c) => (
            <li class:list={["j-card j-ch", { "is-now": c.now }]}>
              <span class="j-yr">{c.yr}</span>
              <div>
                <h3>{c.h}</h3>
                <p>{c.p.replace("{teamSize}", team)}</p>
                <p class="j-gain">Added: {c.added}</p>
              </div>
              <ul class="j-techs" aria-label="Tools">{c.tags.map((t) => <li>{t}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
      <p class="j-more"><a href="/about/">Full background →</a></p>
    </section>

    <section class="j-part" id="work" aria-labelledby="work-h">
      <div class="j-head"><span class="j-num" aria-hidden="true">{S.work.n}</span><div><h2 id="work-h">{S.work.h}</h2><p>{S.work.p}</p></div></div>
      <div class="j-grid">
        <article class="j-card j-w j-w--big">
          <p class="j-eyebrow"><b>{dental.data.pillar}</b> · {dental.data.period}</p>
          <h3><a href={`/projects/${dental.id}/`}>{dental.data.title}</a></h3>
          <p class="j-a">{dental.data.summary}</p>
          <MiniDiagram id="home-dental" caption={dental.data.diagram.caption} nodes={dental.data.diagram.nodes} edges={dental.data.diagram.edges as [string, string][]} />
          <ul class="j-pills" aria-label="What broke">{dental.data.broke.map((b) => <li>{b.title}</li>)}</ul>
        </article>
        <article class="j-card j-w j-w--shot">
          <div class="j-shot">
            <Image class="ht-dark" src={shotHireDark} alt="HireTrack sign-in screen, dark theme" widths={[560, 900]} sizes="(min-width: 860px) 480px, 100vw" />
            <Image class="ht-light" src={shotHireLight} alt="HireTrack sign-in screen, light theme" widths={[560, 900]} sizes="(min-width: 860px) 480px, 100vw" />
          </div>
          <div class="j-w__in">
            <p class="j-eyebrow"><b>Open source</b> · {hiretrack.data.period}</p>
            <h3><a href={`/projects/${hiretrack.id}/`}>HireTrack</a></h3>
            <p class="j-a">{hiretrack.data.summary}</p>
          </div>
        </article>
        <article class="j-card j-w j-w--shot j-w--half">
          <div class="j-shot"><Image src={shotQuetta} alt="The Quetta Tea 2.0 home page" widths={[600, 900]} sizes="(min-width: 860px) 580px, 100vw" /></div>
          <div class="j-w__in">
            <p class="j-eyebrow"><b>Built for a café</b> · {quetta.year}</p>
            <h3><a href={quetta.demo ?? quetta.href}>The Quetta Tea 2.0</a></h3>
            <p class="j-a">{quetta.line}</p>
          </div>
        </article>
        <article class="j-card j-w j-w--half">
          <p class="j-eyebrow"><b>{signal.data.pillar}</b> · {signal.data.period}</p>
          <h3><a href={`/projects/${signal.id}/`}>{signal.data.title}</a></h3>
          <p class="j-a">{signal.data.summary}</p>
          <MiniDiagram id="home-signal" caption={signal.data.diagram.caption} nodes={signal.data.diagram.nodes} edges={signal.data.diagram.edges as [string, string][]} />
          <p class="j-outcome">{signal.data.outcome}</p>
        </article>
      </div>
      <p class="j-more"><a href="/projects/">Every case study, open source project and paper →</a></p>
    </section>

    <section class="j-part" id="toolbox" aria-labelledby="toolbox-h">
      <div class="j-head"><span class="j-num" aria-hidden="true">{S.toolbox.n}</span><div><h2 id="toolbox-h">{S.toolbox.h}</h2><p>{S.toolbox.p}</p></div></div>
      <ul class="j-legend" aria-label="Key">
        <li><span class="j-chip is-daily">Daily</span></li>
        <li><span class="j-chip">Used in production</span></li>
        <li><span class="j-chip is-exp">Project exposure</span></li>
        <li><span class="j-chip is-earlier">Used before</span></li>
      </ul>
      <div class="j-grid">
        {toolbox.areas.map((a) => (
          <article class:list={["j-card j-tool", `span-${a.span}`]}>
            <div class="j-tool__hd"><span class="j-ico"><Icon name={a.icon as any} /></span><h3>{a.name}</h3></div>
            <ul class="j-chips">
              {a.daily.map((t) => <li class="j-chip is-daily">{t}<span class="sr"> (daily)</span></li>)}
              {a.production.map((t) => <li class="j-chip">{t}</li>)}
              {a.exposure.map((t) => <li class="j-chip is-exp">{t}<span class="sr"> (project exposure)</span></li>)}
              {a.earlier.map((t) => <li class="j-chip is-earlier">{t}<span class="sr"> (used before)</span></li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="j-card j-contact" aria-labelledby="close-h">
      <div>
        <p class="j-contact__k">Contact</p>
        <h2 id="close-h">Tell me what the system is doing. Tell me what it should be doing.</h2>
      </div>
      <div class="j-contact__end">
        <p>{profile.location.city}, {profile.location.country} · {profile.availabilityShort}</p>
        <a class="btn btn--lg j-contact__btn" href={`mailto:${profile.email}`}><Icon name="mail" size={18} />{profile.email}</a>
        <a class="j-contact__cv" href={resume.file}>Download résumé</a>
      </div>
    </section>
  </div>
</Base>
