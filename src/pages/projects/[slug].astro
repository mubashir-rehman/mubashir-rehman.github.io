---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageTop from "@/components/PageTop.astro";
import Crumbs from "@/components/Crumbs.astro";
import Diagram from "@/components/Diagram.astro";
import Icon from "@/components/Icon.astro";
import SecHead from "@/components/SecHead.astro";
import profile from "@/data/profile.json";
import roles from "@/data/roles.json";
import { graph, breadcrumb, personRef, SITE } from "@/lib/schema";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: work[(i + 1) % work.length] } }));
}
interface Props { entry: CollectionEntry<"work">; next: CollectionEntry<"work"> }
const { entry, next } = Astro.props;
const d = entry.data;
const path = `/projects/${entry.id}/`;
const canonical = `${SITE}${path}`;
const all = await getCollection("work");
const related = d.related.map((s) => all.find((w) => w.id === s)).filter(Boolean) as CollectionEntry<"work">[];
const role = roles.find((r) => d.tracks.includes(r.slug as never));
const post = d.relatedPost ? (await getCollection("journal")).find((p) => p.id === d.relatedPost && p.data.status === "published") : undefined;
const title = d.seoTitle ?? d.title;
const rulesTotal = all.filter((w) => w.data.rule).length;

const extra: object[] = [];
if (entry.id === "hiretrack" && d.links.repo) extra.push({ "@type": "SoftwareSourceCode", name: "HireTrack", codeRepository: d.links.repo, author: personRef, programmingLanguage: ["TypeScript"] });
if (d.links.paper)
  extra.push({
    "@type": "ScholarlyArticle",
    headline: profile.paper.title,
    sameAs: [profile.paper.url, profile.paper.arxiv],
    datePublished: String(profile.paper.year),
    isPartOf: { "@type": "Periodical", name: profile.paper.journal, publisher: { "@type": "Organization", name: profile.paper.publisher } },
    author: personRef,
  });
const schema = graph([
  {
    "@type": "Article",
    "@id": `${canonical}#article`,
    headline: d.title,
    description: d.description,
    url: canonical,
    articleSection: "Case study",
    author: personRef,
    inLanguage: "en",
    ...(d.asOf ? { dateModified: d.asOf.toISOString().slice(0, 10) } : {}),
    about: d.stack.slice(0, 6),
  },
  breadcrumb(canonical, [{ name: "Work", path: "/projects/" }, { name: d.title, path }]),
  ...extra,
]);
// The journey every case study tells, in order. Labels feed the side spine and the section heads.
const parts = [
  { id: "problem", h: "The problem", p: "What was needed, and what made it hard." },
  { id: "system", h: "The system", p: d.diagram.caption },
  { id: "decisions", h: "Decisions", p: "What I chose, what I turned down, and what it cost." },
  { id: "broke", h: "What broke", p: d.broke.length ? "What I noticed, what caused it, and how I fixed it." : "The honest boundary." },
  { id: "outcome", h: "Outcome", p: "What came of it, and what it was built with." },
  ...(d.rule ? [{ id: "rule", h: "The rule I took from this", p: "The line I keep from this project." }] : []),
].map((x, i) => ({ ...x, n: String(i + 1).padStart(2, "0") }));
const P = Object.fromEntries(parts.map((x) => [x.id, x]));
const fmt = (x: Date) => x.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={title} description={d.description} path={path} schema={schema} article={{ published: d.asOf ?? new Date("2026-09-29"), section: "Case study", tags: d.stack.slice(0, 4) }} resume={(role?.slug as never) ?? undefined}>
  <article class="j wrap cs">
    <PageTop crumbs={[{ name: "Work", path: "/projects/" }, { name: d.title }]} title={d.title} lead={d.summary}>
      <p slot="eyebrow" class="j-eyebrow"><b>{d.pillar}</b> · {d.period}</p>
      {(d.links.repo || d.links.demo || d.links.paper) && (
        <Fragment slot="actions">
          {d.links.repo && <a class="btn btn--secondary" href={d.links.repo}>View the code<svg class="i" aria-hidden="true"><use href="#i-ext" /></svg></a>}
          {d.links.demo && <a class="btn btn--secondary" href={d.links.demo}>View the demo<svg class="i" aria-hidden="true"><use href="#i-ext" /></svg></a>}
          {d.links.paper && <a class="btn btn--secondary" href={d.links.paper}>Read the paper<svg class="i" aria-hidden="true"><use href="#i-ext" /></svg></a>}
        </Fragment>
      )}
      <aside slot="side" class="j-card cs-glance pt-side" aria-label="At a glance">
        <p class="j-eyebrow">At a glance</p>
        <dl>
          <div><dt>Role</dt><dd>{d.role.split(":")[0]}</dd></div>
          <div><dt>Status</dt><dd>{d.status}{d.asOf && <span class="cs-asof"> (as of {fmt(d.asOf)})</span>}</dd></div>
          <div><dt>Outcome</dt><dd>{d.outcome}</dd></div>
        </dl>
      </aside>
    </PageTop>

    <div class="cs-body">
      <nav class="cs-toc" aria-label="On this page">
        <ol>{parts.map((x) => <li><a href={`#${x.id}`}><span>{x.n}</span>{x.h}</a></li>)}</ol>
      </nav>
      <div class="cs-main">
        <section class="cs-part" id="problem" aria-labelledby="problem-h">
          <SecHead small n={P.problem.n} id="problem-h" h={P.problem.h} p={P.problem.p} />
          <div class="j-card cs-prose">
            <p>{d.problem}</p>
            {d.role.includes(":") && <p class="cs-role"><b>My role:</b> {d.role}</p>}
          </div>
        </section>

        <section class="cs-part" id="system" aria-labelledby="system-h">
          <SecHead small n={P.system.n} id="system-h" h={P.system.h} p={P.system.p} />
          <div class="j-card cs-sys"><Diagram id={entry.id} caption={d.diagram.caption} nodes={d.diagram.nodes} edges={d.diagram.edges} /></div>
        </section>

        <section class="cs-part" id="decisions" aria-labelledby="decisions-h">
          <SecHead small n={P.decisions.n} id="decisions-h" h={P.decisions.h} p={P.decisions.p} />
          <div class="cs-stack">
            {d.decisions.map((x, i) => (
              <article class="j-card cs-dec">
                <h3><span class="j-stepn">{i + 1}</span>{x.title}</h3>
                <dl>
                  <div class="is-chose"><dt>I chose</dt><dd>{x.chose}</dd></div>
                  <div class="is-rejected"><dt>I turned down</dt><dd>{x.rejected}</dd></div>
                  <div><dt>Why</dt><dd>{x.why}</dd></div>
                  <div><dt>What it cost</dt><dd>{x.cost}</dd></div>
                </dl>
              </article>
            ))}
          </div>
        </section>

        <section class="cs-part" id="broke" aria-labelledby="broke-h">
          <SecHead small n={P.broke.n} id="broke-h" h={P.broke.h} p={P.broke.p} />
          <div class="cs-stack">
            {d.broke.map((b) => (
              <article class="j-card cs-inc">
                <h3>{b.title}</h3>
                <dl>
                  <div><dt><span class="j-ico j-ico--sm"><Icon name="eye" size={18} /></span>What I saw</dt><dd>{b.symptom}</dd></div>
                  <div><dt><span class="j-ico j-ico--sm"><Icon name="search" size={18} /></span>The cause</dt><dd>{b.cause}</dd></div>
                  <div><dt><span class="j-ico j-ico--sm"><Icon name="wrench" size={18} /></span>The fix</dt><dd>{b.fix}</dd></div>
                </dl>
              </article>
            ))}
            {d.brokeNote && <div class="j-card cs-prose"><p>{d.brokeNote}</p></div>}
          </div>
        </section>

        <section class="cs-part" id="outcome" aria-labelledby="outcome-h">
          <SecHead small n={P.outcome.n} id="outcome-h" h={P.outcome.h} p={P.outcome.p} />
          <div class="j-grid">
            <div class="j-card cs-results">
              <ul>{d.results.map((r) => <li>{r}</li>)}</ul>
            </div>
            <div class="j-card cs-built">
              <h3 class="j-k">Built with</h3>
              <ul class="j-chips">{d.stack.map((t) => <li class="j-chip">{t}</li>)}</ul>
              {d.specified && <><h3 class="j-k cs-spec">Specified, not built by me</h3><ul class="j-chips">{d.specified.map((t) => <li class="j-chip is-exp">{t}</li>)}</ul></>}
            </div>
          </div>
        </section>

        {d.rule && (
          <section class="cs-part" id="rule" aria-labelledby="rule-h">
            <SecHead small n={P.rule.n} id="rule-h" h={P.rule.h} p={P.rule.p} />
            <blockquote class="j-card cs-rule"><p><a href={`/about/#rule-${d.rule.n}`}>{d.rule.text}</a></p><p class="cs-rule__n">Rule {d.rule.n} of {rulesTotal}</p></blockquote>
          </section>
        )}
      </div>
    </div>

    <section class="cs-next" aria-labelledby="next-h">
      <h2 id="next-h" class="sr">Keep reading</h2>
      <div class="j-grid">
        <a class="j-card cs-nextcard" href={`/projects/${next.id}/`}>
          <p class="j-eyebrow"><b>Next case study</b> · {next.data.pillar}</p>
          <p class="cs-nextcard__t">{next.data.title}</p>
          <p class="j-a">{next.data.summary}</p>
          <span class="cs-go" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
        </a>
        <div class="j-card cs-also">
          <p class="j-eyebrow">Also worth reading</p>
          <ul>
            {related.map((r) => <li><a href={`/projects/${r.id}/`}>{r.data.title}</a></li>)}
            {post && <li><a href={`/journal/${post.id}/`}>{post.data.title}</a> <span>(post)</span></li>}
            {role && <li><a href={`/for/${role.slug}/`}>{role.h1}</a> <span>(hiring for this)</span></li>}
            <li><a href="/projects/">All work</a></li>
          </ul>
        </div>
        <div class="j-card j-contact cs-contact">
          <div>
            <p class="j-contact__k">Working on something similar?</p>
            <p class="cs-contact__t">Tell me what the system is doing, and what it should be doing.</p>
          </div>
          <div class="j-contact__end">
            <a class="btn btn--lg j-contact__btn" href={`mailto:${profile.email}?subject=${encodeURIComponent(`About: ${d.title}`)}`}><Icon name="mail" size={18} />Email me about this build</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</Base>
