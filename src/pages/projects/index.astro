---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/Crumbs.astro";
import SecHead from "@/components/SecHead.astro";
import Icon from "@/components/Icon.astro";
import { Image } from "astro:assets";
import shotHireDark from "@/assets/work/hiretrack-dark.jpg";
import shotHireLight from "@/assets/work/hiretrack-light.jpg";
import shotSelfDark from "@/assets/work/portfolio-dark.jpg";
import shotSelfLight from "@/assets/work/portfolio-light.jpg";
import shotQuetta from "@/assets/work/quettatea.jpg";
import problems from "@/data/problems.json";
import MiniDiagram from "@/components/MiniDiagram.astro";
import builds from "@/data/builds.json";
import profile from "@/data/profile.json";
import { numWord, cap } from "@/lib/text";
import { graph, breadcrumb, webPage, personRef, SITE } from "@/lib/schema";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.flagship);
const hiretrackId = "hiretrack";
const researchId = profile.paper.caseStudy.split("/")[2];
const more = work.filter((w) => !w.data.flagship && w.id !== hiretrackId && w.id !== researchId);
const hiretrack = work.find((w) => w.id === "hiretrack")!;
const portfolio = builds.find((b) => b.title === "This portfolio site")!;
const quetta = builds.find((b) => b.title.startsWith("The Quetta Tea 2.0"))!;
const smaller = builds.filter((b) => b !== portfolio && b !== quetta);
const research = work.find((w) => w.id === profile.paper.caseStudy.split("/")[2])!;
// Which "If you have" problem (home page, /services/) each case study answers.
const solves = (id: string) => problems.find((p) => p.slug === id)?.h;
const steps = ["The problem", "The system", "Decisions", "What broke", "Outcome", "The rule I took from it"];
const S = ["featured", "more", "oss", "smaller", "research"].reduce((a, k, i) => ({ ...a, [k]: String(i + 1).padStart(2, "0") }), {} as Record<string, string>);
const title = "Work: Backend, AI and Automation Systems";
const description = "Case studies by Mubashir Rehman: AI backends, integrations, ERP agents, a production AWS backend, open-source tools and published research.";
const canonical = `${SITE}/projects/`;
const schema = graph([
  webPage("CollectionPage", canonical, title, description, {
    author: personRef,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: work.map((w, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE}/projects/${w.id}/`, name: w.data.title })),
    },
  }),
  breadcrumb(canonical, [{ name: "Work", path: "/projects/" }]),
]);
---
<Base title={title} description={description} path="/projects/" schema={schema}>
  <div class="j wrap wk-page">
    <Crumbs items={[{ name: "Work" }]} />
    <div class="j-grid">
      <header class="j-card cs-hero wk-hero">
        <p class="j-eyebrow"><b>Work</b> · {cap(numWord(work.length))} case studies</p>
        <h1>Selected work</h1>
        <p class="j-lead">Systems I built, took over or designed, with the decisions behind them and what broke along the way. Work under NDA is described by function, never by name.</p>
      </header>
      <aside class="j-card wk-how" aria-labelledby="how-h">
        <h2 class="j-eyebrow" id="how-h">How each case study reads</h2>
        <ol>{steps.map((x, i) => <li><span>{String(i + 1).padStart(2, "0")}</span>{x}</li>)}</ol>
      </aside>
    </div>

    <section class="j-part" aria-labelledby="feat-h">
      <SecHead n={S.featured} id="feat-h" h="Featured" p={`One per kind of work: ${featured.map((w) => w.data.pillar).join(", ")}.`} />
      <div class="wk-stack">
        {featured.map((w) => (
          <article class="j-card wk-feat">
            <div class="wk-feat__txt">
              <p class="j-eyebrow"><b>{w.data.pillar}</b> · {w.data.period}</p>
              <h3><a href={`/projects/${w.id}/`}>{w.data.title}</a></h3>
              <p class="j-a">{w.data.summary}</p>
              {solves(w.id) && <p class="wk-solves"><span class="j-k">Solves</span> {solves(w.id)}</p>}
              {w.data.broke.length > 0 && <ul class="j-pills" aria-label="What broke">{w.data.broke.map((b) => <li>{b.title}</li>)}</ul>}
              <p class="j-more"><a href={`/projects/${w.id}/`}>Read the case study →</a></p>
            </div>
            <MiniDiagram id={`wk-${w.id}`} caption={w.data.diagram.caption} nodes={w.data.diagram.nodes} edges={w.data.diagram.edges as [string, string][]} />
          </article>
        ))}
      </div>
    </section>

    <section class="j-part" aria-labelledby="more-h">
      <SecHead n={S.more} id="more-h" h="More case studies" p={`${cap(numWord(more.length))} more systems, each with its decisions and what broke.`} />
      <div class="j-grid">
        {more.map((w) => (
          <article class="j-card wk-card">
            <p class="j-eyebrow"><b>{w.data.pillar}</b> · {w.data.period}</p>
            <h3><a href={`/projects/${w.id}/`}>{w.data.title}</a></h3>
            <p class="j-a">{w.data.summary}</p>
            {solves(w.id) && <p class="wk-solves"><span class="j-k">Solves</span> {solves(w.id)}</p>}
            <p class="j-proof"><a href={`/projects/${w.id}/`}>Read the case study →</a></p>
          </article>
        ))}
      </div>
    </section>

    <section class="j-part" aria-labelledby="oss-h">
      <SecHead n={S.oss} id="oss-h" h="Open source" p="Code you can read, and sites you can open." />
      <div class="j-grid">
        <article class="j-card j-w j-w--shot wk-oss">
          <div class="j-shot">
            <Image class="ht-dark" src={shotHireDark} alt="HireTrack sign-in screen, dark theme" widths={[400, 760]} sizes="(min-width: 860px) 390px, 100vw" />
            <Image class="ht-light" src={shotHireLight} alt="HireTrack sign-in screen, light theme" widths={[400, 760]} sizes="(min-width: 860px) 390px, 100vw" />
          </div>
          <div class="j-w__in">
            <p class="j-eyebrow"><b>{hiretrack.data.pillar}</b> · {hiretrack.data.period}</p>
            <h3><a href={`/projects/${hiretrack.id}/`}>HireTrack</a></h3>
            <p class="j-a">{hiretrack.data.summary}</p>
            <p class="wk-links">{hiretrack.data.links.repo && <a href={hiretrack.data.links.repo}>Code</a>}{hiretrack.data.links.demo && <a href={hiretrack.data.links.demo}>Live demo</a>}<a href={`/projects/${hiretrack.id}/`}>Case study</a></p>
          </div>
        </article>
        <article class="j-card j-w j-w--shot wk-oss">
          <div class="j-shot">
            <Image class="ht-dark" src={shotSelfDark} alt="This portfolio's home page, dark theme" widths={[400, 760]} sizes="(min-width: 860px) 390px, 100vw" />
            <Image class="ht-light" src={shotSelfLight} alt="This portfolio's home page, light theme" widths={[400, 760]} sizes="(min-width: 860px) 390px, 100vw" />
          </div>
          <div class="j-w__in">
            <p class="j-eyebrow"><b>Open source</b> · {portfolio.year}</p>
            <h3><a href={portfolio.href}>{portfolio.title}</a></h3>
            <p class="j-a">{portfolio.line}</p>
            <p class="wk-links"><a href={portfolio.href}>Code</a></p>
          </div>
        </article>
        <article class="j-card j-w j-w--shot wk-oss">
          <div class="j-shot"><Image src={shotQuetta} alt="The Quetta Tea 2.0 home page" widths={[400, 760]} sizes="(min-width: 860px) 390px, 100vw" /></div>
          <div class="j-w__in">
            <p class="j-eyebrow"><b>Built for a café</b> · {quetta.year}</p>
            <h3><a href={quetta.demo}>The Quetta Tea 2.0</a></h3>
            <p class="j-a">{quetta.line}</p>
            <p class="wk-links"><a href={quetta.href}>Code</a><a href={quetta.demo}>Live site</a></p>
          </div>
        </article>
      </div>
    </section>

    <section class="j-part" id="smaller-builds" aria-labelledby="sb-h">
      <SecHead n={S.smaller} id="sb-h" h="Smaller builds" p="One line each. Work under NDA is described by function." />
      <ul class="j-grid wk-builds">
        {smaller.map((b) => (
          <li class="j-card wk-build">
            {b.year && <p class="j-eyebrow">{b.year}</p>}
            <h3>{b.href ? <a href={b.href}>{b.title}</a> : b.title}</h3>
            <p class="j-a">{b.line}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="j-part" aria-labelledby="res-h">
      <SecHead n={S.research} id="res-h" h="Research" p={`Peer-reviewed, ${profile.paper.publisher}, ${profile.paper.year}.`} />
      <article class="j-card wk-feat">
        <div class="wk-feat__txt">
          <p class="j-eyebrow"><b>Research</b> · {profile.paper.citation}</p>
          <h3><a href={profile.paper.caseStudy}>{profile.paper.title}</a></h3>
          <p class="j-a"><b>My part:</b> {profile.paper.contribution}</p>
          <p class="wk-links"><a href={profile.paper.url}>DOI {profile.paper.doi}</a><a href={profile.paper.arxiv}>arXiv preprint</a><a href={profile.paper.caseStudy}>How the study was built</a></p>
        </div>
        <MiniDiagram id={research.id} caption={research.data.diagram.caption} nodes={research.data.diagram.nodes} edges={research.data.diagram.edges as [string, string][]} />
      </article>
    </section>
  </div>
</Base>
