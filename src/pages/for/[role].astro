---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/Crumbs.astro";
import SecHead from "@/components/SecHead.astro";
import Icon from "@/components/Icon.astro";
import { numWord, cap } from "@/lib/text";
import profile from "@/data/profile.json";
import roles from "@/data/roles.json";
import { graph, breadcrumb, faqPage, webPage, personRef, SITE } from "@/lib/schema";

export function getStaticPaths() {
  return roles.map((role) => ({ params: { role: role.slug }, props: { role } }));
}
const { role } = Astro.props as { role: (typeof roles)[number] };
const work = await getCollection("work");
const resume = profile.resumes[role.slug as keyof typeof profile.resumes];
const path = `/for/${role.slug}/`;
const canonical = `${SITE}${path}`;
const others = roles.filter((r) => r.slug !== role.slug);
const schema = graph([
  webPage("WebPage", canonical, role.seoTitle, role.description, { about: personRef }),
  breadcrumb(canonical, [{ name: role.h1, path }]),
  faqPage(canonical, role.faqs),
]);
---
<Base title={role.seoTitle} description={role.description} path={path} schema={schema} resume={role.slug as never}>
  <div class="j wrap">
    <Crumbs items={[{ name: `Hiring: ${role.label}` }]} />
    <nav class="switch ro-switch" aria-label="Role pages">
      <span class="j-eyebrow">Hiring for</span>
      <ul>{roles.map((r) => <li><a href={`/for/${r.slug}/`} aria-current={r.slug === role.slug ? "page" : undefined}>{r.label}</a></li>)}</ul>
    </nav>
    <div class="j-grid">
      <header class="j-card cs-hero wk-hero">
        <p class="j-eyebrow"><b>Hiring for</b> · {role.label}</p>
        <h1>{role.h1}</h1>
        <p class="j-lead">{role.fit}</p>
        <p class="j-cta">
          <a class="btn btn--primary btn--lg" href={resume.file}><Icon name="download" size={18} />Résumé for {role.label} (PDF)</a>
          <a class="btn btn--secondary btn--lg" href={`mailto:${profile.email}`}><Icon name="mail" size={18} />Email me</a>
        </p>
      </header>
      <aside class="j-card cs-glance" aria-labelledby="prac-h">
        <h2 class="j-eyebrow" id="prac-h">Practicalities</h2>
        <dl>
          <div><dt>Based in</dt><dd>{profile.location.city}, {profile.location.country} · {profile.location.timezone}</dd></div>
          <div><dt>Works</dt><dd>{profile.availability}</dd></div>
          <div><dt>Experience</dt><dd>{profile.yearsFullTime} years, full-time</dd></div>
          <div><dt>Now</dt><dd>{profile.current.title}, {profile.current.employer}</dd></div>
        </dl>
      </aside>
    </div>

    <section class="j-part" aria-labelledby="ev-h">
      <SecHead n="01" id="ev-h" h="Evidence" p={`${cap(numWord(role.evidence.length))} builds that match this role.`} />
      <div class="j-grid">
        {role.evidence.map((e) => {
          const w = "slug" in e ? work.find((x) => x.id === e.slug) : undefined;
          const href = w ? `/projects/${w.id}/` : (e as { href: string }).href;
          return (
            <article class="j-card ro-ev">
              {w && <p class="j-eyebrow"><b>{w.data.pillar}</b> · {w.data.period}</p>}
              <h3><a href={href}>{w ? w.data.title : "More builds"}</a></h3>
              <p class="j-a">{e.line}</p>
              <p class="j-proof"><a href={href}>{w ? "Read the case study →" : "See more builds →"}</a></p>
            </article>
          );
        })}
      </div>
    </section>

    <section class="j-part" aria-labelledby="st-h">
      <SecHead n="02" id="st-h" h="Stack for this role" p="The full toolbox is on the home page." />
      <div class="j-card ro-stack">
        <span class="j-ico"><Icon name="code-xml" /></span>
        <ul class="j-chips">{role.stack.map((t) => <li class="j-chip">{t}</li>)}</ul>
        <p class="wk-links"><a href="/#toolbox">Full toolbox</a><a href="/projects/">All case studies</a></p>
      </div>
    </section>

    <section class="j-part" aria-labelledby="q-h">
      <SecHead n="03" id="q-h" h="Questions" p="What hiring teams usually ask first." />
      <div class="j-grid">
        {role.faqs.map((f) => (
          <article class="j-card ro-q">
            <h3>{f.q}</h3>
            <p class="j-a">{f.a}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="j-card j-contact" aria-labelledby="close-h">
      <div>
        <p class="j-contact__k">Hiring for {role.label.toLowerCase()}</p>
        <h2 id="close-h">Tell me about the role and the system behind it.</h2>
      </div>
      <div class="j-contact__end">
        <p>{profile.location.city}, {profile.location.country} · {profile.availabilityShort}</p>
        <a class="btn btn--lg j-contact__btn" href={`mailto:${profile.email}`}><Icon name="mail" size={18} />{profile.email}</a>
        <a class="j-contact__cv" href={resume.file}>Résumé for {role.label} (PDF)</a>
      </div>
    </section>
  </div>
</Base>
