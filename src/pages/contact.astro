---
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/Crumbs.astro";
import Icon from "@/components/Icon.astro";
import Portrait from "@/components/Portrait.astro";
import profile from "@/data/profile.json";
import roles from "@/data/roles.json";
import { getCollection } from "astro:content";
import { numWord, cap } from "@/lib/text";
import { graph, breadcrumb, webPage, SITE, PERSON_ID } from "@/lib/schema";

const caseCount = (await getCollection("work")).length;
const title = "Contact";
const description = "Email Mubashir Rehman about backend, AI automation or integration roles. Based in Lahore, Pakistan, open to remote work in any timezone.";
const canonical = `${SITE}/contact/`;
const schema = graph([
  webPage("ContactPage", canonical, title, description, { about: { "@type": "Person", "@id": PERSON_ID, name: profile.name, email: `mailto:${profile.email}` } }),
  breadcrumb(canonical, [{ name: "Contact", path: "/contact/" }]),
]);
---
<Base title={title} description={description} path="/contact/" schema={schema}>
  <div class="j wrap">
    <Crumbs items={[{ name: "Contact" }]} />
    <section class="j-card j-contact ct-hero" aria-labelledby="ct-h">
      <div>
        <h1 id="ct-h">Contact</h1>
        <p class="ct-line">Tell me what the system is doing. Tell me what it should be doing.</p>
        <p class="ct-lead">Email is fastest. A role or a problem, in two lines, is enough.</p>
      </div>
      <div class="j-contact__end">
        <p>{profile.location.city}, {profile.location.country} · {profile.location.timezone}</p>
        <a class="btn btn--lg j-contact__btn" href={`mailto:${profile.email}`}><Icon name="mail" size={18} />{profile.email}</a>
      </div>
    </section>
    <div class="j-grid ct-grid">
      <Portrait class="ct-photo" right={profile.jobTitle} />
      <aside class="j-card cs-glance ct-glance" aria-label="Details">
        <p class="j-eyebrow">Details</p>
        <dl>
          <div><dt>Works</dt><dd>{profile.availability} Open to select engagements.</dd></div>
          <div><dt>Elsewhere</dt><dd class="wk-links"><a href={profile.links.linkedin}>LinkedIn</a><a href={profile.links.github}>GitHub</a><a href={profile.links.scholar}>Google Scholar</a></dd></div>
          <div><dt>Résumé by role</dt><dd class="wk-links">{roles.map((r) => <a href={profile.resumes[r.slug as keyof typeof profile.resumes].file}>{r.label}</a>)}</dd></div>
        </dl>
      </aside>
      <a class="j-card cs-nextcard ct-way" href="/services/">
        <span class="j-ico"><Icon name="wrench" /></span>
        <p class="cs-nextcard__t">Problems I solve</p>
        <p class="j-a">Workflows across systems that do not talk to each other, and AI on top of them.</p>
      </a>
      <a class="j-card cs-nextcard ct-way" href="/projects/">
        <span class="j-ico"><Icon name="layout-dashboard" /></span>
        <p class="cs-nextcard__t">{cap(numWord(caseCount))} case studies</p>
        <p class="j-a">Problem, system, decisions and what broke, for each one.</p>
      </a>
    </div>
  </div>
</Base>
