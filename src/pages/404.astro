---
import Base from "@/layouts/Base.astro";
---
<Base title="Page Not Found" description="That address does not exist on mubashirrehman.com, or the page moved. Try the home page, the work index or the writing." path="/404/" noindex>
  <div class="wrap page-head">
    <p class="meta">404</p>
    <h1 class="h1">Nothing here.</h1>
    <p class="lead">That address does not exist, or the page moved. Try one of these.</p>
    <p class="actions" style="margin-top:var(--s-6)"><a class="btn btn--primary" href="/">Go to the home page</a></p>
    <p class="small" style="margin-top:var(--s-5)"><a class="link" href="/projects/">Work</a>, <a class="link" href="/journal/">Writing</a>, <a class="link" href="/contact/">Contact</a></p>
  </div>
</Base>
