---
// Tiny and administrative: the header navigates, the footer closes. Role pages are reached from
// the home hero, /about/ and the sitemap; the chat lives on the home page only.
import profile from "@/data/profile.json";
const year = new Date().getFullYear();
const resume = profile.resumes[profile.defaultResume as keyof typeof profile.resumes];
---
<footer class="foot wrap">
  <p class="foot__id"><strong>{profile.name}</strong> · {profile.label}</p>
  <nav aria-label="Footer">
    <ul class="foot__nav">
      <li><a href="/projects/">Work</a></li>
      <li><a href="/journal/">Writing</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href={profile.links.github} rel="me">GitHub</a></li>
      <li><a href={profile.links.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={profile.links.scholar} rel="me">Scholar</a></li>
      <li><a href={resume.file}>Résumé</a></li>
    </ul>
  </nav>
  <p class="foot__base">© {year} · Work under NDA is described by function, never by name. · <a href="https://github.com/mubashir-rehman/mubashir-rehman.github.io">Source</a></p>
</footer>
