---
// The closing card on every page, in the same grid as the cards above it: who, the site,
// the role pages, and profiles elsewhere. Links use the navigation role (see cards.css).
import profile from "@/data/profile.json";
import roles from "@/data/roles.json";
const year = new Date().getFullYear();
const resume = profile.resumes[profile.defaultResume as keyof typeof profile.resumes];
const site = [
  { href: "/projects/", label: "Work" },
  { href: "/journal/", label: "Writing" },
  { href: "/about/", label: "About" },
  { href: "/services/", label: "Problems I solve" },
  { href: "/contact/", label: "Contact" },
];
const elsewhere = [
  { href: profile.links.github, label: "GitHub" },
  { href: profile.links.linkedin, label: "LinkedIn" },
  { href: profile.links.scholar, label: "Google Scholar" },
  { href: profile.links.orcid, label: "ORCID" },
];
---
<footer class="j wrap ft">
  <div class="j-card ft-card">
    <div class="ft-id">
      <a class="ft-brand" href="/" aria-label={`${profile.name}, home`}><svg class="i" aria-hidden="true"><use href="#mark" /></svg>{profile.name}</a>
      <p class="ft-label">{profile.label} · {profile.location.city}, {profile.availabilityShort.toLowerCase()}</p>
      <p class="ft-links"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={resume.file}>Résumé (PDF)</a></p>
    </div>
    <nav class="ft-col" aria-labelledby="ft-site"><p class="j-eyebrow" id="ft-site">Site</p><ul>{site.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
    <nav class="ft-col" aria-labelledby="ft-roles"><p class="j-eyebrow" id="ft-roles">Hiring for</p><ul>{roles.map((r) => <li><a href={`/for/${r.slug}/`}>{r.label}</a></li>)}</ul></nav>
    <nav class="ft-col" aria-labelledby="ft-else"><p class="j-eyebrow" id="ft-else">Elsewhere</p><ul>{elsewhere.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}<li><a href="/rss.xml">RSS feed</a></li></ul></nav>
    <p class="ft-base">© {year} {profile.name} · Work under NDA is described by function, never by name. · <a href="https://github.com/mubashir-rehman/mubashir-rehman.github.io">Source</a></p>
  </div>
</footer>
