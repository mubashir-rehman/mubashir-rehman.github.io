---
// The path spine: the hero trace turned vertical. Noisy at the top (the early years), settling
// into a flat line toward the current role. Seeded, so every build draws the same line.
// Decorative only.
const W = 90, H = 1000, settle = 720, mid = 40;
let s = 7 >>> 0;
const r = () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
const pts: [number, number][] = [[mid - 12, 0]];
let y = 0;
while (y < settle - 20) {
  y += 18 + r() * 12;
  const t = Math.min(y / settle, 1);
  const amp = 26 * (1 - t) ** 1.8 + 0.5;
  pts.push([mid + (r() * 2 - 1) * amp, Math.min(y, settle - 4)]);
}
pts.push([mid, settle], [mid, H]);
const d = "M" + pts.map(([x, py]) => `${x.toFixed(1)} ${py.toFixed(1)}`).join(" L");
---
<svg class="spine" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={d} vector-effect="non-scaling-stroke" /></svg>
