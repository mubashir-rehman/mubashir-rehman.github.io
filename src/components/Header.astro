---
// Four visible links and one action at every width (no hamburger: with four destinations there
// is nothing to hide). On phones the links take a second row.
import profile from "@/data/profile.json";

interface Props {
  path: string;
  resume?: keyof typeof profile.resumes;
}
const { path, resume = profile.defaultResume as keyof typeof profile.resumes } = Astro.props;
const r = profile.resumes[resume];
const links = [
  { href: "/projects/", label: "Work" },
  { href: "/journal/", label: "Writing" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
const current = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---
<header class="site-head">
  <nav class="nav wrap" aria-label="Main">
    <a class="brand" href="/" aria-label={`${profile.name}, home`}><svg class="i" aria-hidden="true"><use href="#mark" /></svg>{profile.name}</a>
    <ul class="nav__links">
      {links.map((l) => <li><a href={l.href} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a></li>)}
    </ul>
    <div class="nav__end">
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Switch theme">
        <svg class="i ic-to-light" aria-hidden="true"><use href="#i-sun" /></svg><svg class="i ic-to-dark" aria-hidden="true"><use href="#i-moon" /></svg>
      </button>
      <a class="btn btn--primary btn--sm" href={r.file} aria-label={`Résumé, ${r.label}, PDF`}>Résumé</a>
    </div>
  </nav>
</header>
<script is:inline>
  (function () {
    var d = document.documentElement, b = document.querySelector("[data-theme-toggle]");
    if (!b) return;
    function label() { b.setAttribute("aria-label", d.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme"); }
    label();
    // Phones: hide the header while scrolling down, bring it back on any scroll up or focus.
    var h = document.querySelector(".site-head"), last = scrollY;
    addEventListener("scroll", function () {
      var y = scrollY;
      if (h) h.classList.toggle("is-hidden", y > last && y > 120);
      last = y;
    }, { passive: true });
    if (h) h.addEventListener("focusin", function () { h.classList.remove("is-hidden"); });
    b.addEventListener("click", function () {
      var t = d.dataset.theme === "dark" ? "light" : "dark";
      d.dataset.theme = t;
      try { localStorage.setItem("theme", t); } catch (e) {}
      label();
    });
  })();
</script>
