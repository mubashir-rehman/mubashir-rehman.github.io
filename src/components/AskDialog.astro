---
// "Ask the engineer": opened by any [data-ask-open] control (optionally with data-ask-q, a
// question to send straight away). The HTML ships an empty shell on purpose: the contents are
// built by src/scripts/ask.ts on first open, so no chat text follows the footer in the page
// source. The client script and the context file load only when the dialog opens.
---
<dialog class="ask-dialog" id="ask" aria-label="Ask the engineer"></dialog>
<script>
  const dialog = document.getElementById("ask") as HTMLDialogElement | null;
  let chat: ReturnType<typeof import("../scripts/ask").mountAsk> | null = null;
  document.addEventListener("click", async (e) => {
    const t = e.target as HTMLElement;
    const opener = t.closest<HTMLElement>("[data-ask-open]");
    if (opener && dialog) {
      dialog.showModal();
      if (!chat) {
        const { mountAsk } = await import("../scripts/ask");
        chat = mountAsk(dialog);
      }
      const q = opener.dataset.askQ;
      if (q) chat.ask(q);
      else chat.focus();
    }
    if (t.closest("[data-ask-close]")) dialog?.close();
  });
</script>
