---
/**
 * Base.astro — HTML shell for every page.
 *
 * Responsibilities:
 *  - Emit a fully-formed <head> with static SEO metadata (title, description,
 *    canonical, og/twitter, robots, structured data).  This is what search
 *    engines and social scrapers see — no JavaScript needed.
 *  - Apply the saved theme class before first paint to prevent FOUC.
 *  - Render a <slot /> so each Astro page can inject its React island.
 */

import "../index.css";
import profile from "@/data/profile.json";

interface ArticleMeta {
  publishedTime: string;
  author?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  schema?: object | object[];
  articleMeta?: ArticleMeta;
}

// SITE stays a literal: it is the root of the canonical/sitemap URL contract
// (and must match astro.config.mjs `site`), so it must not move with content
// edits. It is identical to profile.website — keep the two in step by hand.
const SITE        = "https://mubashir-rehman.is-a.dev";

// Title/description are NOT typed here — they live in profile.json under `seo`,
// the same single-source-of-truth pattern src/lib/askmePrompt.ts uses for the
// chatbot prompt. Edit the copy there, not here.
const BASE_TITLE  = profile.seo.baseTitle;
const BASE_DESC   = profile.seo.baseDescription;
const OG_IMAGE    = `${SITE}/og-image.png`;

const {
  title,
  description = BASE_DESC,
  canonicalPath = "/",
  schema,
  articleMeta,
} = Astro.props;

const fullTitle   = title ? `${title} | ${BASE_TITLE}` : BASE_TITLE;

// The site is built with `trailingSlash: "always"` and deployed to GitHub Pages,
// which serves directory-format URLs (/about/ → about/index.html) and 301-redirects
// the slash-less form. The canonical must therefore match the served URL exactly —
// and the same string the sitemap emits. Normalize whatever the caller passed:
// exactly one leading slash, exactly one trailing slash ("/" stays "/").
const trimmedPath  = (canonicalPath ?? "/").replace(/^\/+/, "").replace(/\/+$/, "");
const canonicalURL = trimmedPath ? `${SITE}/${trimmedPath}/` : `${SITE}/`;
const ogType       = articleMeta ? "article" : "website";

// Only suppress indexing on non-canonical deployments (e.g. raw github.io URL)
const isCanonical =
  Astro.url.hostname === "mubashir-rehman.is-a.dev" ||
  Astro.url.hostname === "localhost" ||
  Astro.url.hostname === "127.0.0.1";

// --- Person schema inputs, derived from profile.json ---------------------
// profile.location is "<city>, <country>" — split it rather than re-typing both.
const [locality, countryName] = profile.location.split(",").map((s) => s.trim());

// Education is listed most-recent/highest-first, so [0] is the degree-granting
// institution schema.org's alumniOf wants.
const alma = profile.education[0].institution;

// sameAs must contain only off-site *profile* URLs: `website` duplicates `url`
// and `email` is not a URL, so both are excluded. Named explicitly (rather than
// filtered heuristically) so adding a socialLink can't silently change the claim.
const sameAs = ["github", "linkedin"].map((k) => profile.socialLinks[k]);

// Shared person + website structured data (included on every page)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.seo.jobTitle,
  description: BASE_DESC,
  url: profile.website,
  image: OG_IMAGE,
  email: profile.email,
  nationality: { "@type": "Country", name: countryName },
  address: {
    "@type": "PostalAddress",
    addressLocality: locality,
    // ISO 3166-1 alpha-2; no equivalent in profile.json, same as the SOC code below.
    addressCountry: "PK",
  },
  alumniOf: {
    "@type": "EducationalOrganization",
    name: alma,
  },
  hasOccupation: {
    "@type": "Occupation",
    name: profile.seo.jobTitle,
    // O*NET-SOC code for Software Developers — no JSON equivalent, stays literal.
    occupationalCategory: "15-1252.00",
    skills: profile.seo.occupationSkills,
  },
  // Curated in profile.json rather than flattened from profile.skills: flattening
  // yields 55 entries, drops 10 current claims (Distributed Systems, Machine
  // Learning, RAG, Microservices, REST API design, …) and introduces 9 slash-
  // compound values ("OAuth2 / JWT / RBAC") that are poor schema.org terms.
  knowsAbout: profile.seo.knowsAbout,
  sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Theme FOUC prevention — runs synchronously before first paint.
         Also re-applies after Astro view transitions (astro:after-swap),
         because the swap replaces <html> and drops the theme class. -->
    <script is:inline>
      (function () {
        function applyTheme() {
          var t = localStorage.getItem("theme");
          // Only light/dark are supported; migrate any legacy/unknown value.
          if (t !== "light" && t !== "dark") {
            t = "light";
            localStorage.setItem("theme", t);
          }
          document.documentElement.classList.remove("light", "dark");
          document.documentElement.classList.add(t);
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>

    <!-- Fonts are self-hosted (declared in index.css) — preload the primary
         face so text renders without a swap flash. -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Feed discovery. /rss.xml is a FILE, not a directory — no trailing slash
         (trailingSlash: "always" applies to routes, not static assets). -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Mubashir Rehman — Blog"
      href="/rss.xml"
    />

    {!isCanonical && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:type"        content={ogType} />
    <meta property="og:image"       content={OG_IMAGE} />

    <!-- Article-specific OG -->
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:author"          content={articleMeta.author ?? "Mubashir Rehman"} />
        {articleMeta.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={OG_IMAGE} />

    <!-- Person schema (present on all pages) -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Page-specific structured data -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
