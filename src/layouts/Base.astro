---
// The HTML shell for every page: head metadata (title, description, canonical, social cards,
// one JSON-LD graph), the theme script, header, footer and the chat dialog.
import "@/styles/global.css";
import profile from "@/data/profile.json";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Icons from "@/components/Icons.astro";
// Ask feature disabled: no active LLM API key, and the dialog's script was an eager module on
// every page, chaining off the initial navigation in the page-speed critical path.
// To re-enable: uncomment this import and the <AskDialog /> mount at the end of <body>.
// import AskDialog from "@/components/AskDialog.astro";
import { SITE } from "@/lib/schema";

interface Article {
  published: Date;
  modified?: Date;
  section: string;
  tags?: string[];
}
interface Props {
  title: string;
  description: string;
  path: string;
  schema?: object;
  og?: string;
  ogAlt?: string;
  article?: Article;
  noindex?: boolean;
  resume?: keyof typeof profile.resumes;
}

const { title, description, path, schema, og = "/og/default.png", ogAlt, article, noindex = false, resume } = Astro.props;

// Title rule (docs/redesign/40-search-strategy.md §3.0): no suffix if the name is already in the
// title; otherwise append " | Mubashir Rehman" only while the total stays within 60.
const SUFFIX = ` | ${profile.name}`;
const fullTitle = title.includes(profile.name) || title.length + SUFFIX.length > 60 ? title : title + SUFFIX;

// Canonical: exactly one leading and one trailing slash, matching the sitemap byte for byte.
const trimmed = path.replace(/^\/+/, "").replace(/\/+$/, "");
const canonical = trimmed ? `${SITE}/${trimmed}/` : `${SITE}/`;
const ogUrl = og.startsWith("http") ? og : `${SITE}${og}`;

// Never index a non-canonical host (the raw github.io address, preview deploys).
const host = Astro.url.hostname;
const isCanonicalHost = ["mubashirrehman.com", "localhost", "127.0.0.1"].includes(host);
const robots = noindex || !isCanonicalHost ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Theme before first paint. Follows the system unless the visitor chose one.
      (function () {
        var d = document.documentElement, t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        d.dataset.theme = t;
        d.classList.add("js");
      })();
    </script>
    <link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="alternate" type="application/rss+xml" title={`Writing: ${profile.name}`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={profile.seo.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt ?? title} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
        <meta property="article:section" content={article.section} />
        <meta property="article:author" content={`${SITE}/about/`} />
        {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Icons />
    <a class="skip" href="#main">Skip to content</a>
    <Header path={canonical.replace(SITE, "")} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Ask feature disabled (see import above): uncomment to re-enable. Triggers are in index.astro and contact.astro. -->
    <!-- <AskDialog /> -->
  </body>
</html>
